# ─────────────────────────────────────────────────────────────────────────────
# RiskPilot AI — Universal .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & Security (API Keys, Connection URIs, Credentials) ──────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.crt

# ── Node.js / React Frontend ──────────────────────────────────────────────────
frontend/node_modules/
frontend/build/
frontend/dist/
node_modules/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Java / Spring Boot Backend (Maven) ─────────────────────────────────────────
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.log
*.sql
.mvn/
mvnw
mvnw.cmd

# ── Python / ML Service ───────────────────────────────────────────────────────
ml-service/venv/
ml-service/.venv/
ml-service/__pycache__/
ml-service/saved_model/
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.h5
*.pkl

# ── IDEs & Editor Configuration ───────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iws
*.iml
*.ipr
*.swp
*.swo

# ── Operating System Artifacts ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Local Agent / Scratch Files ────────────────────────────────────────────────
.gemini/
.agents/
scratch/
